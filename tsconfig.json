{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/core/src",
    "packages/core/test",
    "packages/daemon/src",
    "packages/daemon/test",
    "packages/summarizer/src",
    "packages/summarizer/test",
    "packages/cli/src",
    "packages/cli/test"
  ]
}
